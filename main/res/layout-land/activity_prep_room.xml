<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".prep.prepRoom">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.85"
        android:background="@drawable/yamoos" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/prep_view_pager2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <pl.droidsonroids.gif.GifImageButton
        android:id="@+id/back_button"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="10dp"

        android:background="@drawable/back_gif"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


<!--    go-->
<!--    this float over both vp2-->
    <FrameLayout
        android:id="@+id/char_overview_button_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_bias="0.9"
        app:layout_constraintVertical_bias="0.97">

        <ImageButton
            android:id="@+id/start_button"
            android:layout_width="200dp"
            android:layout_height="75dp"
            android:background="@drawable/sign"
            android:contentDescription="@string/start_game"
            android:foreground="?android:attr/selectableItemBackground"

            android:padding="10sp"
            android:theme="@android:style/ThemeOverlay.Material.Dark" />

        <TextView
            style="@style/normal_text_bold"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"

            android:clickable="false"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="@string/start_game"
            android:textSize="20sp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>