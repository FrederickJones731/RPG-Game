                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="4"
                    android:alpha="0.95"
                    android:background="@drawable/woodpecker"

                    android:fontFamily="sans-serif-black"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:text="@string/char_moves"
                    android:textColor="#DD000913"
                    android:textSize="14sp"
                    android:theme="@android:style/ThemeOverlay.Material.Dark" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>



    <View
        android:id="@+id/halfsies"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:background="#3B000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.55"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />


    <TextView
        android:id="@+id/next_group_header"
        style="@style/alt_text_bold2"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        app:layout_constraintStart_toEndOf="@id/halfsies"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/player_num_tv"
        app:layout_constraintHorizontal_bias="0.12"
        android:text="Next Skirmish:"
        android:gravity="center_vertical"/>

    <FrameLayout
        android:id="@+id/leader_image_framelayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginEnd="8dp"
        android:layout_marginStart="14dp"
        android:layout_marginVertical="10dp"

        app:layout_constraintTop_toBottomOf="@id/next_group_header"
        app:layout_constraintStart_toEndOf="@id/halfsies">

        <ImageView
            android:layout_width="69dp"
            android:layout_height="80dp"
            android:rotation="90"
            android:background="@drawable/sign"/>

        <ImageView
            android:id="@+id/group_leader_imageview"
            android:layout_width="40dp"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:alpha="0.85"
            android:clickable="true"
            android:background="@drawable/suneki"/>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/group_details_ll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/leader_image_framelayout"
        app:layout_constraintTop_toBottomOf="@id/next_group_header">

        <TextView
            android:id="@+id/group_header_tv"
            style="@style/alt_text_bold2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:gravity="start"

            android:textSize="16sp"
            android:text="Team Suneki"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                style="@style/alt_text_small2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginVertical="5dp"
                android:layout_marginStart="20dp"
                android:gravity="start"

                android:textSize="13sp"
                android:text="Group Type:"/>

            <TextView
                android:id="@+id/group_type_tv"
                style="@style/alt_text_bold2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginVertical="5dp"
                android:layout_marginStart="15dp"
                android:gravity="start"

                android:textStyle="bold"
                android:textSize="13sp"
                android:text="Offensive"/>

        </LinearLayout>



    </LinearLayout>


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:background="@drawable/background_greys"
        app:layout_constraintStart_toStartOf="@id/next_group_header"
        app:layout_constraintTop_toBottomOf="@id/leader_image_framelayout">

        <TextView
            android:id="@+id/difficulty_tv"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="30dp"

            android:text="Strength Value:"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/diff_num_tv"
            style="@style/alt_text_bold2"
            android:layout_width="50dp"
            android:layout_height="match_parent"

            android:gravity="center"
            android:text="16"
            app:layout_constraintStart_toEndOf="@id/player_char_count_tv"
            app:layout_constraintTop_toTopOf="@id/player_char_count_tv" />
    </LinearLayout>


    <pl.droidsonroids.gif.GifImageButton
        android:id="@+id/back_button"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="10dp"

        android:background="@drawable/back_gif"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <FrameLayout
        android:id="@+id/char_overview_button_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_bias="0.9"
        app:layout_constraintVertical_bias="0.97">

        <ImageButton
            android:id="@+id/start_button"
            android:layout_width="200dp"
            android:layout_height="75dp"
            android:background="@drawable/sign"
            android:contentDescription="@string/start_game"
            android:foreground="?android:attr/selectableItemBackground"

            android:padding="10sp"
            android:theme="@android:style/ThemeOverlay.Material.Dark" />

        <TextView
            style="@style/normal_text_bold"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"

            android:clickable="false"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="@string/start_game"
            android:textSize="20sp" />

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>