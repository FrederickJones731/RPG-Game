<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".prep.warRoom">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/yamoos"
        android:alpha="0.8"
        android:elevation="-3dp"/>
    <TextView
        android:id="@+id/title"
        style="@style/Title"
        android:layout_width="340dp"
        android:layout_height="0sp"

        android:layout_marginTop="5dp"
        android:background="@drawable/redrivium"
        android:text="Campaign Mode - Gauntlet 17"
        android:textColor="#173A6C"
        android:textSize="20sp"
        android:textStyle="bold"

        app:flow_horizontalBias="0.1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/player_char_count_tv"
        style="@style/alt_text_header2"
        android:layout_width="200sp"
        android:layout_height="0sp"
        android:layout_marginTop="25sp"

        android:text="Player Char Count:"
        app:layout_constraintHorizontal_weight="1.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <TextView
        android:id="@+id/player_num_tv"
        style="@style/alt_text_header2"
        android:layout_width="50dp"
        android:layout_height="0dp"

        android:gravity="center"
        android:text="3"
        app:layout_constraintHorizontal_weight="1.5"
        app:layout_constraintStart_toEndOf="@id/player_char_count_tv"
        app:layout_constraintTop_toTopOf="@id/player_char_count_tv" />

    <LinearLayout
        android:id="@+id/player_seekbar_ll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintEnd_toStartOf="@id/halfsies"

        app:layout_constraintHorizontal_bias="0.3"
        app:layout_constraintHorizontal_weight="3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_char_count_tv">
        <!--    player number tv-->
        <TextView
            style="@style/alt_text_bold"
            android:layout_width="40dp"

            android:layout_height="50dp"
            android:gravity="center"
            android:text="-"


            app:layout_constraintBottom_toTopOf="@id/seekbar_player"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


        <SeekBar
            android:id="@+id/seekbar_player"
            android:layout_width="250dp"
            android:layout_height="50dp"

            android:max="299"
            android:progress="299"
            android:progressDrawable="@drawable/hpbar"
            android:thumb="@drawable/enthusiasm" />

        <TextView
            style="@style/alt_text"
            android:layout_width="40dp"

            android:layout_height="50dp"
            android:gravity="center"
            android:text="+"


            app:layout_constraintBottom_toTopOf="@id/seekbar_player"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


    </LinearLayout>

