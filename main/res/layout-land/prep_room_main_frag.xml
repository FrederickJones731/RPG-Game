        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_p1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:checked="true"
            android:gravity="center"
            android:paddingEnd="15dp"
            android:textOff="@string/row_the_second"
            android:textOn="@string/row_the_first" />

        <Spinner
            android:id="@+id/spinner_1"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="5"

            android:background="#99807F7F"
            android:contentDescription="@string/hide_bottom_view_on_scroll_behavior" />

        <Button
            android:id="@+id/move_selector1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="4"
            android:alpha="0.95"
            android:background="@drawable/woodpecker"

            android:fontFamily="sans-serif-black"
            android:text="@string/char_moves"
            android:textColor="#DD000913"
            android:textSize="14sp"
            android:foreground="?android:attr/selectableItemBackground"
            android:theme="@android:style/ThemeOverlay.Material.Dark" />

    </LinearLayout>

