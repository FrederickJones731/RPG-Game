    <LinearLayout
        android:id="@+id/player_levels"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="7dp"
        android:layout_marginTop="30dp"
        android:paddingStart="5dp"

        app:layout_constraintStart_toEndOf="@id/halfsies"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clash_ll">

        <TextView
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_weight="2"
            android:text="Player Level: " />

        <EditText
            android:id="@+id/edit_text_player_lvl"
            style="@style/alt_text_small2"
            android:layout_width="130dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:gravity="center"
            android:hint="1 - 50"
            android:inputType="number" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/map_picker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="7dp"
        android:layout_marginTop="3dp"
        android:gravity="fill_horizontal"

        app:layout_constraintStart_toEndOf="@id/halfsies"
