    <View
        android:id="@+id/halfsies"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:background="#3B000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.55"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <TextView
        android:id="@+id/clash_tv"
        style="@style/alt_text"
        android:layout_width="wrap_content"

        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="19dp"
        android:background="@drawable/redrivium"
        android:paddingHorizontal="5dp"
        android:paddingVertical="3dp"
        android:text="Clash Reaction Mode:"
        android:textSize="20sp"

        app:layout_constraintStart_toEndOf="@id/halfsies"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <LinearLayout
        android:id="@+id/clash_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:layout_marginVertical="18dp"
        android:gravity="center"
        android:background="@drawable/redrivium"
        app:layout_constraintStart_toEndOf="@id/halfsies"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clash_tv">

        <ImageButton
            android:id="@+id/clash_down_button"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/down_arrow"
            android:rotation="90"
            android:alpha="0.8"
            android:foreground="?android:attr/selectableItemBackground"
            android:theme="@android:style/ThemeOverlay.Material.Dark"
            android:src="@drawable/dark_redoo" />

        <TextView
            android:id="@+id/clash_mode_tv"
            style="@style/alt_text"
            android:layout_width="100dp"

            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="55dp"
            android:text="NONE"
            android:textStyle="bold"
            android:textColor="#073202"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title" />

        <ImageButton
            android:id="@+id/clash_up_button"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/up_arrow"
            android:rotation="90"
            android:alpha="0.8"
            android:src="@drawable/groen"
            android:foreground="?android:attr/selectableItemBackground"
            android:theme="@android:style/ThemeOverlay.Material.Dark"
            android:contentDescription="@string/phys_avo" />

    </LinearLayout>

