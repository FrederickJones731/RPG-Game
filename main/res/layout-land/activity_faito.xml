    <!--    attack forecast-->
    <TextView
        android:id="@+id/fight_attack_forecast"
        style="@style/alt_text_small"
        android:layout_width="160dp"
        android:layout_height="wrap_content"

        android:layout_marginBottom="9dp"
        android:alpha="0.8"
        android:background="@drawable/lowen"
        android:clickable="false"
        android:elevation="5dp"
        android:gravity="start"
        android:padding="13dp"

        android:text="Hit: \nCrit: 100% + 13%\nBlock: "
        android:textColor="#000000"
        android:textSize="15sp"

        app:layout_constraintEnd_toStartOf="@id/enemy_row_1"
        app:layout_constraintStart_toEndOf="@id/player_row_1"
        app:layout_constraintTop_toBottomOf="@id/effectiveness_forecast" />

    <!--    effectiveness forecast-->
    <LinearLayout
        android:id="@+id/effectiveness_forecast"
        android:layout_width="160dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="30dp"
        android:layout_marginBottom="17dp"
        android:alpha="0.8"
        android:background="@drawable/lowen"
        android:clickable="false"
        android:elevation="5dp"
        android:gravity="start"
        android:orientation="vertical"
        android:padding="8dp"

        app:layout_constraintStart_toStartOf="@id/fight_attack_forecast"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/aff_eff_icon_atkr"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_margin="4dp"
                android:background="@drawable/symbol_glacier" />

            <TextView
                style="@style/alt_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="3dp"
                android:text="->" />

            <ImageView
                android:id="@+id/aff_eff_icon_def"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_margin="4dp"
                android:background="@drawable/symbol_steel" />

            <ImageView
                android:id="@+id/aff_eff_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginVertical="4dp"
                android:layout_marginStart="15dp"
                android:background="@drawable/up_arrow" />

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginVertical="3dp"
            android:background="#90515151" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/weapon_eff_icon_atkr"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_margin="4dp"
                android:background="@drawable/weapon_icon_magic" />

            <TextView
                style="@style/alt_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="3dp"
                android:text="->" />

            <ImageView
                android:id="@+id/weapon_eff_icon_def"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_margin="4dp"
                android:background="@drawable/weapon_icon_spear" />

            <ImageView
                android:id="@+id/weapon_eff_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginVertical="4dp"
                android:layout_marginStart="15dp"
                android:background="@drawable/down_arrow" />

        </LinearLayout>

    </LinearLayout>



    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginHorizontal="11dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/background_greys"

        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/enemy_row_1"
        app:layout_constraintStart_toEndOf="@id/player_row_1"
        app:layout_constraintTop_toBottomOf="@id/fight_attack_forecast">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:fillViewport="true">

            <declatoration.simulatorial.fight.fightUpdater
                android:id="@+id/fight_log"
                style="@style/alt_text_small2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:background="#B2707874"
                android:fontFamily="@font/ubuntu_bold_italic"
                android:foreground="@drawable/dark_bloo"
                android:gravity="start"
                android:elevation="25dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="14dp"
                android:textColor="#000000"
                android:textSize="12sp" />


        </ScrollView>

        <declatoration.simulatorial.fight.clashReactionForecast
            android:id="@+id/clash_reaction_forecast"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </FrameLayout>
