<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fight_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grass"
    android:orientation="horizontal">


    <declatoration.simulatorial.fight.largeBarsContainerLayout
        android:id="@+id/large_bar_player"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <declatoration.simulatorial.fight.largeBarsContainerLayout
        android:id="@+id/large_bar_enemy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:focusable="false"
        android:clickable="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!--    back button-->
    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="40sp"
        android:layout_height="40sp"
        android:layout_margin="4dp"

        android:background="@drawable/back_gif"
        android:contentDescription="@string/back"
        android:elevation="30dp"

        android:theme="@android:style/ThemeOverlay.Material.Dark"
        android:foreground="?android:attr/selectableItemBackground"
        app:layout_constraintEnd_toStartOf="@id/large_bar_enemy"
        app:layout_constraintStart_toEndOf="@id/effectiveness_forecast"
        app:layout_constraintTop_toTopOf="parent" />

    <!--    setting button-->
    <ImageButton
        android:id="@+id/settings_button"
        android:layout_width="40sp"
        android:layout_height="40sp"

        android:layout_marginVertical="4dp"
        android:background="@drawable/sett"
        android:contentDescription="@string/back"

        app:layout_constraintEnd_toStartOf="@id/effectiveness_forecast"
        app:layout_constraintTop_toTopOf="parent" />


    <View
        android:id="@+id/linetops"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.32" />

    <!-- player line 1 -->
    <LinearLayout
        android:id="@+id/player_row_1"
        android:layout_width="80sp"
        android:layout_height="0sp"
        android:background="#3C403F3F"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintHorizontal_bias="0.24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/large_bar_player"
        app:layout_constraintTop_toTopOf="@id/player_row_2">


    </LinearLayout>

    <!--    AD403F3F-->

    <!-- player line 2 -->
    <LinearLayout
        android:id="@+id/player_row_2"
        android:layout_width="80sp"
        android:layout_height="0sp"
        android:background="#3C403F3F"
        android:gravity="center"
        android:orientation="vertical"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.07"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/linetops">


    </LinearLayout>

    <!-- enemy line 1  -->
    <LinearLayout
        android:id="@+id/enemy_row_1"
        android:layout_width="80sp"
        android:layout_height="0sp"

        android:background="#3C403F3F"
        android:gravity="center"
        android:orientation="vertical"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.76"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/large_bar_player"
        app:layout_constraintTop_toTopOf="@id/player_row_2" />

    <!-- enemy line 2  -->
    <LinearLayout
        android:id="@+id/enemy_row_2"
        android:layout_width="80sp"
        android:layout_height="0sp"
        android:background="#3C403F3F"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintHorizontal_bias="0.93"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/large_bar_player"
        app:layout_constraintTop_toTopOf="@id/player_row_2" />

