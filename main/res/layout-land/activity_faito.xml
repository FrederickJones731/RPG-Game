    <!--        android:textSize="20sp" -->
    <!--        app:layout_constraintTop_toTopOf="parent"-->
    <!--        app:layout_constraintStart_toStartOf="parent"/>-->


    <!--    player outcome-->
    <LinearLayout
        android:id="@+id/player_outcome_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:elevation="33dp"
        android:orientation="vertical"
        android:translationX="-5dp"
        android:visibility="gone"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">


        <TextView
            android:id="@+id/fight_update_player_name"
            style="@style/alt_text_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:background="@drawable/fight_update"

            android:clickable="false"
            android:elevation="5dp"
            android:gravity="end"
            android:minWidth="100dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="13dp"

            android:text="Reika"
            android:textColor="#0B4560"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/fight_update_player"
            style="@style/alt_text_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"

            android:alpha="1"
            android:background="@drawable/fight_update"
            android:clickable="false"
            android:elevation="5dp"
            android:gravity="end"
            android:paddingHorizontal="17dp"
            android:paddingVertical="13dp"

            android:text="27 damage! \nA Critical Hit! \nReika blocked!"
            android:textColor="#000000"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/fight_update_player_ko"
            style="@style/alt_text_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="1"

            android:background="@drawable/fight_update"
            android:clickable="false"
            android:elevation="5dp"
            android:gravity="end"
            android:lines="2"
            android:paddingHorizontal="17dp"
            android:paddingVertical="13dp"

            android:text="Krillith has\nbeen KOed!"
            android:textColor="#EB8C0B0B"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!--enemy outcome-->
    <LinearLayout
        android:id="@+id/enemy_outcome_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:elevation="35dp"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <TextView
            android:id="@+id/fight_update_enemy_name"
            style="@style/alt_text_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"

            android:background="@drawable/fight_update_enemy"
            android:clickable="false"
            android:elevation="5dp"
            android:gravity="start"
            android:maxLines="1"
            android:minWidth="100dp"
            android:padding="13dp"
            android:paddingHorizontal="17dp"

            android:text="Magia (W)"
            android:textColor="#EB8C0B0B"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/fight_update_enemy"
            style="@style/alt_text_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"

            android:background="@drawable/fight_update_enemy"
            android:clickable="false"
            android:elevation="5dp"
            android:gravity="start"
            android:paddingHorizontal="17dp"
            android:paddingVertical="13dp"

            android:text="14 damage! \nA Critical Hit! \nAttack blocked!"
            android:textColor="#000000"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/fight_update_enemy_ko"
            style="@style/alt_text_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:background="@drawable/fight_update_enemy"
            android:clickable="false"
            android:elevation="5dp"
            android:gravity="start"
            android:lines="2"
            android:paddingHorizontal="17dp"
            android:paddingVertical="13dp"

            android:text="Magia(W) has\nbeen KOed!"
            android:textColor="#0B4560"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>


    <View
        android:id="@+id/rage_click_blocker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>


