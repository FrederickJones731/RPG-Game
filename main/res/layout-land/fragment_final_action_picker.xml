<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/attack_layout">


    <LinearLayout
        android:id="@+id/attack_button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.92">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topLL"
            android:layout_width="match_parent"
            android:layout_height="70sp"
            android:layout_margin="5dp"
            android:gravity="center"


            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">



            <Button
                android:id="@+id/row_action"
                android:layout_width="wrap_content"
                android:layout_height="50sp"
                android:layout_marginStart="80sp"

                android:background="@drawable/buttonback"
                android:fontFamily="monospace"

                android:text="@string/row"
                android:textColor="#000000"
                android:textSize="15sp"

                app:layout_constraintBottom_toBottomOf="@id/focus_action"
                app:layout_constraintStart_toStartOf="parent" />



            <Button
                android:id="@+id/guard_action"
                android:layout_width="wrap_content"
                android:layout_height="50sp"
                android:layout_marginHorizontal="60sp"

                android:background="@drawable/buttonback"
                android:fontFamily="monospace"

                android:text="@string/guard"
                android:textColor="#000000"
                android:textSize="15sp"

                app:layout_constraintBottom_toBottomOf="@id/focus_action"
                app:layout_constraintEnd_toStartOf="@id/wait_action"
                app:layout_constraintStart_toEndOf="@+id/row_action" />

            <Button
                android:id="@+id/wait_action"
                android:layout_width="wrap_content"
                android:layout_height="50sp"

                android:background="@drawable/buttonback"
                android:fontFamily="monospace"

                android:text="@string/wait_action"
                android:textColor="#000000"
                android:textSize="15sp"

                app:layout_constraintBottom_toBottomOf="@id/focus_action"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <Button
                android:id="@+id/focus_action"
                android:layout_width="wrap_content"
                android:layout_height="50sp"
                android:layout_marginHorizontal="60sp"

                android:background="@drawable/buttonback"
                android:fontFamily="monospace"

                android:text="@string/focus"
                android:textColor="#000000"
                android:textSize="15sp"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/wait_action"
                app:layout_constraintEnd_toStartOf="@id/assist_action"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/assist_action"
                android:layout_width="wrap_content"
                android:layout_height="50sp"
                android:layout_marginEnd="80sp"

                android:background="@drawable/buttonback"
                android:fontFamily="monospace"

                android:text="@string/assist"
                android:textColor="#000000"
                android:textSize="15sp"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />




        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomLL"
            android:layout_width="match_parent"
            android:layout_height="70sp"
            android:layout_margin="5dp"
            android:gravity="center"


            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">



            <Button
                android:id="@+id/special_button1"
                android:layout_width="120dp"
                android:layout_height="60sp"

                android:background="@drawable/buttonback"
                android:fontFamily="monospace"

                android:text="special"
                android:textColor="#000000"
                android:textSize="15sp"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>



            <Button
                android:id="@+id/special_button2"
                android:layout_width="wrap_content"
                android:layout_height="55sp"


                android:background="@drawable/buttonback"
                android:fontFamily="monospace"

                android:text="special"
                android:textColor="#000000"
                android:textSize="15sp"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/rrrrrr"
                app:layout_constraintEnd_toStartOf="@id/special_button1"
                app:layout_constraintTop_toTopOf="parent" />


            <Button
                android:id="@+id/rrrrrr"
                android:layout_width="wrap_content"
                android:layout_height="55sp"


                android:background="@drawable/redrivium"
                android:fontFamily="monospace"

                android:text=""
                android:textColor="#000000"
                android:textSize="15sp"
                android:clickable="false"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/special_button2"
                app:layout_constraintTop_toTopOf="parent" />


            <Button
                android:id="@+id/special_button3"
                android:layout_width="wrap_content"
                android:layout_height="55sp"
                android:layout_marginLeft="10sp"

                android:background="@drawable/buttonback"
                android:fontFamily="monospace"

                android:text="Special"
                android:textColor="#000000"
                android:textSize="15sp"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/special_button1"
                app:layout_constraintEnd_toStartOf="@id/aff_special_button"
                app:layout_constraintHorizontal_bias="0.7"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/aff_special_button"
                android:layout_width="wrap_content"
                android:layout_height="55sp"
                android:layout_marginLeft="10sp"

                android:background="@drawable/buttonback"
                android:fontFamily="monospace"

                android:text="aff"
                android:textColor="#000000"
                android:textSize="15sp"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/special_button3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>


    <Button
        android:id="@+id/hide_attack_layout_button"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="10dp"
        android:background="@drawable/buttonback"
        android:foreground="@drawable/pointer"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/screen_blocker"
        android:elevation="100dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>