<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".prep.onset">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ic_launcher_background"
        android:alpha="0.85"/>

    <TextView
        android:id="@+id/title"
        style="@style/alt_text_header2"
        android:layout_width="280dp"
        android:layout_height="70dp"
        android:background="@drawable/background_greys"

        android:text="Onset"
        android:textSize="32dp"
        android:textStyle="italic"
        android:layout_marginTop="5dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        style="@style/alt_text_small"
        android:id="@+id/onset_rules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="12dp"
        android:paddingHorizontal="10dp"
        android:textSize="15dp"
        android:text="@string/onset_instructions"
        app:layout_constraintTop_toBottomOf="@id/title"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@id/onset_rules"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/onset_char_row_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


        </LinearLayout>

    </ScrollView>


    <FrameLayout
        android:id="@+id/onset_back_button_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:elevation="10dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/onset_back_button"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:background="@drawable/fight_update_enemy"
            android:contentDescription="@string/start_game"
            android:foreground="?android:attr/selectableItemBackground"

            android:padding="10sp"
            android:theme="@android:style/ThemeOverlay.Material.Dark" />

        <TextView
            style="@style/normal_text_bold"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"

            android:clickable="false"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="Back to Main Screen"
            android:textSize="19sp" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/char_overview_button_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:elevation="10dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/onset_start_button"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:background="@drawable/fight_update"
            android:contentDescription="@string/start_game"
            android:foreground="?android:attr/selectableItemBackground"

            android:padding="10sp"
            android:theme="@android:style/ThemeOverlay.Material.Dark" />

        <TextView
            style="@style/normal_text_bold"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"

            android:clickable="false"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="BEGIN!!!"
            android:textSize="25sp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>