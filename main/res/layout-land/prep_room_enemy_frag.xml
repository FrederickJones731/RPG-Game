                        <!--            android:inputType="number" />-->
                    </LinearLayout>

                    <!-- char selection linear layout 3-->
                    <LinearLayout
                        android:id="@+id/ll_char_selection_3"
                        android:layout_width="match_parent"
                        android:layout_height="0sp"
                        android:layout_marginVertical="8dp"
                        android:layout_marginStart="10sp"
                        android:layout_marginEnd="10sp"
                        android:layout_weight="3"
                        android:gravity="center"
                        >

                        <!--        <TextView-->
                        <!--            style="@style/alt_text_bold"-->
                        <!--            android:layout_width="0dp"-->

                        <!--            android:layout_height="50dp"-->
                        <!--            android:layout_weight="2"-->
                        <!--            android:gravity="center"-->
                        <!--            android:text="*" />-->

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_p3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2"
                            android:checked="true"
                            android:gravity="center"
                            android:paddingEnd="15dp"
                            android:textOff="@string/row_the_second"
                            android:textOn="@string/row_the_first" />

                        <Spinner
                            android:id="@+id/spinner_3"
                            android:layout_width="0dp"
