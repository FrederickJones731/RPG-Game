                        <!--            android:text="*" />-->

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_p4"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2"
                            android:checked="true"
                            android:gravity="center"
                            android:paddingEnd="15dp"
                            android:textOff="@string/row_the_second"
                            android:textOn="@string/row_the_first" />

                        <Spinner
                            android:id="@+id/spinner_4"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="5"


                            android:background="#99807F7F"
                            android:contentDescription="@string/hide_bottom_view_on_scroll_behavior" />

