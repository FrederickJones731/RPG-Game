            <View
                android:id="@+id/scroll_blocker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:elevation="500dp"
                android:background="@drawable/background_greys"
                android:clickable="true"

                app:layout_constraintTop_toTopOf="@id/char_selector_view"
                app:layout_constraintBottom_toBottomOf="@id/char_selector_view"
                app:layout_constraintEnd_toEndOf="@id/char_selector_view"
                app:layout_constraintStart_toStartOf="@id/char_selector_view"
                android:focusable="true" />
