<!--    enemy side-->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="25dp"
        app:layout_constraintStart_toEndOf="@id/halfsies"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toBottomOf="@id/midpoint">


        <LinearLayout
            android:id="@+id/enemy_levels_ll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            android:layout_margin="7dp"


            android:gravity="fill_horizontal"
            android:paddingStart="5dp"
            app:layout_constraintStart_toEndOf="@id/halfsies"
            app:layout_constraintTop_toBottomOf="@id/enemy_levels_ll">

            <TextView
                style="@style/alt_text_bold2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:text="Enemy Level: " />

            <EditText
                android:id="@+id/edit_text_enemy_lvl"
                style="@style/alt_text_small2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:autofillHints=""
                android:gravity="center"
                android:hint="1 - 50"
                android:background="@drawable/background_greys"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/enemy_str_level_ll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            android:layout_margin="7dp"

            android:gravity="fill_horizontal"
            android:paddingStart="5dp"
            app:layout_constraintStart_toEndOf="@id/halfsies"
            app:layout_constraintTop_toBottomOf="@id/enemy_levels_ll">

            <TextView
                style="@style/alt_text_bold2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:layout_weight="2"
                android:text="Strength Level: " />

            <EditText
                android:id="@+id/edit_text_str_level"
                style="@style/alt_text_small2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:autofillHints=""
                android:background="@drawable/background_greys"
                android:gravity="center"
                android:hint="1 - 25"
                android:inputType="number" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/top_strip_ll"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginVertical="6dp"
            android:layout_marginHorizontal="7dp"

            android:paddingStart="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/halfsies"
            app:layout_constraintTop_toBottomOf="@id/title"
            android:orientation="horizontal">

            <TextView
                style="@style/alt_text_bold2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:layout_weight="1.5"
                android:text="@string/enemy_chars" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/char_enemy_switch"
                style="@style/alt_text_small2"
                android:checked="false"
                android:layout_weight="0.5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center" />

            <TextView
                android:id="@+id/char_enemy_toggle_tv"
                style="@style/alt_text_bold2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:maxLines="2"
                android:gravity="center"
                android:textStyle="italic"
                android:textSize="15dp"
                android:text="@string/enemy_toggle_2" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/enemy_ai_toggle_ll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            android:layout_margin="7dp"

            android:gravity="fill_horizontal"
            android:paddingStart="5dp"
            app:layout_constraintStart_toEndOf="@id/halfsies"
            app:layout_constraintTop_toBottomOf="@id/enemy_levels_ll">

            <TextView
                style="@style/alt_text_bold2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:text="AI Mode: " />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/ai_toggle_switch"
                style="@style/alt_text_small2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:checked="true"
                android:layout_weight="0.5"
                android:gravity="center" />

            <TextView
                android:id="@+id/ai_mode_toggle_tv"
                style="@style/alt_text_bold2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textStyle="italic"
                android:textSize="15dp"
                android:text="@string/on" />
        </LinearLayout>

    </LinearLayout>


    <View
        android:id="@+id/midpoint"
        android:layout_width="0.1dp"
        android:layout_height="0.1dp"
        app:layout_constraintTop_toTopOf="@id/player_side_ll"
        app:layout_constraintBottom_toBottomOf="@id/player_side_ll"
        app:layout_constraintVertical_bias="0.82"
        app:layout_constraintStart_toEndOf="@id/halfsies"/>
    <View
        android:id="@+id/halfsies"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:background="#3B000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.55"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />



</androidx.constraintlayout.widget.ConstraintLayout>