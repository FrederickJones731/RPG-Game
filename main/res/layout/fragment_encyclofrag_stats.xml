        <View
            android:layout_width="match_parent"
            android:layout_height="2sp"
            android:background="#63000000"/>

        <TableRow
            android:gravity="center"
            android:paddingStart="20sp"
            android:paddingEnd="20sp"
            android:layout_width="match_parent"
            android:layout_height="0sp"
            android:layout_weight="3">

            <TextView

                android:text="@string/atk"
                style="@style/normal_text_bold"

                android:layout_weight="4"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/current_char_atk"
                android:text="3"
                android:paddingStart="8sp"
                style="@style/normal_text_italic"
                android:layout_weight="5"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="@string/def"
                style="@style/normal_text_bold"


                android:layout_weight="4"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/current_char_def"
                android:text="11"
                style="@style/normal_text_italic"
                android:paddingStart="8sp"
                android:layout_weight="5"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

        </TableRow>

        <TableRow
            android:gravity="center"
            android:paddingStart="20sp"
            android:paddingEnd="20sp"
            android:layout_width="match_parent"
            android:layout_height="0sp"
            android:layout_weight="3">

            <TextView

                android:text="@string/mag"
                style="@style/normal_text_bold"


                android:layout_weight="4"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/current_char_mag"
                android:text="19"
                style="@style/normal_text_italic"
                android:paddingStart="8sp"
                android:layout_weight="5"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="@string/intellect"
                style="@style/normal_text_bold"


                android:layout_weight="4"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/current_char_int"
                android:text="31"
                style="@style/normal_text_italic"
                android:paddingStart="8sp"
                android:layout_weight="5"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

        </TableRow>

        <TableRow
            android:gravity="center"
            android:paddingStart="20sp"
            android:paddingEnd="20sp"
            android:layout_width="match_parent"
            android:layout_height="0sp"
            android:layout_weight="3">

            <TextView

                android:text="@string/spd"
                style="@style/normal_text_bold"


                android:layout_weight="4"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/current_char_spd"
                android:text="16"
                style="@style/normal_text_italic"
                android:paddingStart="8sp"
                android:layout_weight="5"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="@string/lck"
                style="@style/normal_text_bold"


                android:layout_weight="4"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/current_char_lck"
                style="@style/normal_text_italic"
                android:paddingStart="8sp"
                android:layout_width="0sp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:text="49" />

        </TableRow>

        <View
            android:layout_width="match_parent"
            android:layout_height="2sp"
            android:background="#63000000"/>

        <TableRow
            android:gravity="center"
            android:paddingStart="20sp"
            android:paddingEnd="20sp"
            android:layout_width="match_parent"
            android:layout_height="0sp"
            android:layout_weight="3">

            <TextView

                android:text="@string/hit"
                style="@style/normal_text_bold"
                android:layout_weight="4"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>
            <!-- hit is times 5 fsr I dunno-->
            <TextView
                android:id="@+id/current_char_hit"
                android:text="105"
                style="@style/normal_text_italic"
                android:paddingStart="8sp"
                android:layout_weight="5"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="@string/crit"
                style="@style/normal_text_bold"
                android:layout_weight="4"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/current_char_crit"
                android:text="1"
                style="@style/normal_text_italic"
                android:paddingStart="8sp"
                android:layout_weight="5"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

        </TableRow>

        <TableRow
            android:gravity="center"
            android:paddingStart="20sp"
            android:paddingEnd="20sp"
            android:layout_width="match_parent"
            android:layout_height="0sp"
            android:layout_weight="3">

            <TextView

                android:text="@string/phys_avo"
                style="@style/normal_text_bold"
                android:layout_weight="4"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/current_char_phys_avo"
                android:text="12"
                style="@style/normal_text_italic"
                android:paddingStart="8sp"
                android:layout_weight="5"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="@string/mag_avo"
                style="@style/normal_text_bold"
                android:layout_weight="4"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/current_char_mag_avo"
                android:text="30"
                style="@style/normal_text_italic"
                android:paddingStart="8sp"
                android:layout_weight="5"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:paddingStart="20sp"
            android:paddingEnd="20sp"
            android:layout_height="0sp"
            android:gravity="center"
            android:layout_weight="3">

            <TextView

                android:text="@string/block"
                style="@style/normal_text_bold"
                android:textSize="25dp"

                android:maxLines="1"

                android:layout_weight="4"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/current_char_block"
                android:text="6"
                style="@style/normal_text_italic"
                android:paddingStart="8sp"
                android:layout_weight="5"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="@string/res"
                style="@style/normal_text_bold"


                android:layout_weight="4"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/current_char_res"
                android:text="14%"
                style="@style/normal_text_italic"
                android:paddingStart="8sp"
                android:layout_weight="5"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

        </TableRow>




    </TableLayout>


</FrameLayout>