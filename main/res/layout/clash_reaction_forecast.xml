<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clash_reaction_forecast"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:alpha="0.8"
    android:background="@drawable/lowen"
    android:clickable="false"
    android:elevation="5dp"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_marginBottom="5dp"
    android:padding="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clash_effect_headline"
        android:layout_weight="0.76"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/clash_eff_header"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:layout_marginStart="9dp"
            android:text="Clash Reaction:"
            android:textSize="19dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>


        <ImageView
            android:id="@+id/clash_eff_aff_icon1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="4dp"
            android:background="@drawable/symbol_glacier"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/unga_bunga"/>

        <TextView
            android:id="@+id/unga_bunga"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:layout_marginVertical="1.5dp"
            android:layout_marginHorizontal="5dp"
            android:text="->"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/clash_eff_aff_icon2"/>

        <ImageView
            android:id="@+id/clash_eff_aff_icon2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="4dp"
            android:background="@drawable/symbol_glacier"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clash_effect_line1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/clash_eff_icon_1"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="4dp"
            android:background="@drawable/symbol_glacier"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/clash_eff_tv_1"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:layout_marginStart="9dp"
            android:text="Intimidate:"
            android:textSize="15sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/clash_eff_icon_1"/>

        <TextView
            android:id="@+id/clash_eff_perc_tv_1"
            style="@style/alt_text_small2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:layout_marginVertical="1.5dp"
            android:layout_marginStart="8dp"
            android:text="30%"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/clash_eff_tv_1"/>

        <TextView
            android:id="@+id/clash_eff_target_tv_1"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"

            android:text="SELF"
            android:textSize="15sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginVertical="3dp"
        android:background="#90515151" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clash_effect_line2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/clash_eff_icon_2"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="4dp"
            android:background="@drawable/symbol_fire"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/clash_eff_tv_2"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:layout_marginStart="9dp"
            android:text="Knockback:"
            android:textSize="15sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/clash_eff_icon_2"/>

        <TextView
            android:id="@+id/clash_eff_perc_tv_2"
            style="@style/alt_text_small2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:layout_marginVertical="1.5dp"
            android:layout_marginStart="8dp"
            android:text="100%"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/clash_eff_tv_2"/>

        <TextView
            android:id="@+id/clash_eff_target_tv_2"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"

            android:text="TARGET"
            android:textSize="15sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


</LinearLayout>