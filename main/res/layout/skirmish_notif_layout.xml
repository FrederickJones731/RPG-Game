<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="@drawable/dark_bloo"
    android:background="@drawable/buttonback"
    android:paddingVertical="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <TextView
        style="@style/alt_text_header2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/title"
        android:layout_margin="5dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="10dp"
        android:background="@drawable/background_greys"
        android:foreground="@drawable/dark_bloo"
        android:textSize="28dp"
        android:text="Final Results"/>

<!--    notif score layout-->
    <RelativeLayout
        android:id="@+id/notif_score_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/title">

        <TextView
            android:id="@+id/score_name_tv"
            style="@style/alt_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:text="Final Score:"
            android:textColor="#173A6C"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/notif_score_tv"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_toEndOf="@id/score_name_tv"
            android:text="2112"/>

        <TextView
            android:id="@+id/notif_score_new_record_tv"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:maxLines="1"
            android:textSize="18dp"
            android:text="NEW RECORD!!!!"
            android:layout_alignTop="@id/notif_score_tv"
            android:layout_alignBottom="@id/notif_score_tv"
            android:layout_alignParentEnd="true"/>

    </RelativeLayout>

<!--    high score-->
    <RelativeLayout
        android:id="@+id/notif_high_score_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="33dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/notif_score_layout">

        <TextView
            android:id="@+id/high_score_name_tv"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:text="High Score:"
            android:textSize="18dp"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/notif_high_score_tv"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_toEndOf="@id/high_score_name_tv"
            android:text="1921"
            android:textSize="18dp"/>


    </RelativeLayout>




<!--    notif round layout-->
    <RelativeLayout
        android:id="@+id/notif_round_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/notif_high_score_layout">

        <TextView
            android:id="@+id/round_name_tv"
            style="@style/alt_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:text="Round Reached:"
            android:textColor="#173A6C"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/notif_round_tv"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_toEndOf="@id/round_name_tv"
            android:text="18" />

        <TextView
            android:id="@+id/notif_round_new_record_tv"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:maxLines="1"
            android:textSize="18dp"
            android:text="NEW RECORD!!!!"
            android:layout_alignTop="@id/notif_round_tv"
            android:layout_alignBottom="@id/notif_round_tv"
            android:layout_alignParentEnd="true"/>

    </RelativeLayout>

<!--    high round-->
    <RelativeLayout
        android:id="@+id/notif_high_round_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="33dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/notif_round_layout">

        <TextView
            android:id="@+id/high_round_name_tv"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:text="Round Reached Record:"
            android:textSize="18dp"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/notif_high_round_tv"
            style="@style/alt_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_toEndOf="@id/high_round_name_tv"
            android:text="13"
            android:textSize="18dp"/>


    </RelativeLayout>


<!--    back button-->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:background="@drawable/background_greys"
        android:foreground="@drawable/dark_bloo"
        android:gravity="center"
        android:paddingVertical="10dp"

        app:layout_constraintTop_toBottomOf="@id/notif_high_round_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/notif_back_button_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="10dp">

            <ImageButton
                android:id="@+id/notif_back_button"
                android:layout_width="240dp"
                android:layout_height="70dp"
                android:background="@drawable/fight_update"
                android:contentDescription="@string/start_game"
                android:foreground="?android:attr/selectableItemBackground"

                android:padding="10sp"
                android:theme="@android:style/ThemeOverlay.Material.Dark" />

            <TextView
                style="@style/normal_text_bold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"

                android:clickable="false"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="Back to Main Screen"
                android:textSize="23sp" />

        </FrameLayout>

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>