<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="22dp"
    android:paddingStart="55dp"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="horizontal">


    <ImageView
        android:id="@+id/stat_buff_dot_1"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_margin="1.5dp"
        android:layout_gravity="center"

        android:background="@drawable/neutral_dot"/>

    <ImageView
        android:id="@+id/stat_buff_dot_2"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_margin="1.5dp"
        android:layout_gravity="center"

        android:background="@drawable/neutral_dot"/>

    <ImageView
        android:id="@+id/stat_buff_dot_3"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_margin="1.5dp"
        android:layout_gravity="center"

        android:background="@drawable/neutral_dot"/>

    <ImageView
        android:id="@+id/stat_buff_dot_4"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_margin="1.5dp"
        android:layout_gravity="center"

        android:background="@drawable/neutral_dot"/>




    <TextView
        android:id="@+id/stat_pane_stat_name_tv"
        style="@style/alt_text_small"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:paddingHorizontal="10dp"
        android:background="@drawable/lowen"
        android:maxLines="1"
        android:gravity="center"
        android:layout_marginHorizontal="6dp"

        android:text="ATK"
        android:textColor="#D5000000"
        android:textSize="15sp"

        android:paddingBottom="2dp"/>


    <ImageView
        android:id="@+id/stat_buff_dot_5"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_margin="1.5dp"
        android:layout_gravity="center"

        android:background="@drawable/neutral_dot"/>

    <ImageView
        android:id="@+id/stat_buff_dot_6"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_margin="1.5dp"
        android:layout_gravity="center"

        android:background="@drawable/neutral_dot"/>

    <ImageView
        android:id="@+id/stat_buff_dot_7"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_margin="1.5dp"
        android:layout_gravity="center"

        android:background="@drawable/neutral_dot"/>

    <ImageView
        android:id="@+id/stat_buff_dot_8"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_margin="1.5dp"
        android:layout_gravity="center"

        android:background="@drawable/neutral_dot"/>

</LinearLayout>