<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/deloriasis"
    android:gravity="center"
    tools:context=".prep.prepRoom">


    <ImageView
        android:id="@+id/weapon_icon"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_margin="10sp"

        android:background="@drawable/enthusiasm"
        android:alpha="0.92"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="@string/focus" />


    <TextView
        android:id="@+id/spinner_char_name"
        style="@style/normal_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10sp"

        android:text="Jimbo"
        android:fontFamily="sans-serif-condensed-medium"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/weapon_icon"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>