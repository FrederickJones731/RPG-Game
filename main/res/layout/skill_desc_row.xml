<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/redrivium"
    android:paddingBottom="12dp">



    <ImageView
        android:id="@+id/skill_icon"
        android:background="@drawable/enthusiasm"
        android:layout_width="45sp"
        android:layout_height="45sp"
        android:layout_margin="10sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/skill_name"
        style="@style/normal_text_bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8sp"

        android:text="Ghastly Sorcerer"
        android:textColor="#000000"

        app:layout_constraintVertical_bias="0.85"
        app:layout_constraintTop_toTopOf="@id/skill_icon"
        app:layout_constraintBottom_toBottomOf="@id/skill_icon"
        app:layout_constraintStart_toEndOf="@id/skill_icon"/>

    <TextView
        android:id="@+id/skill_desc"
        style="@style/normal_text_italic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8sp"
        android:paddingStart="30dp"

        android:textSize="20sp"
        android:textColor="#DF0B0B0B"
        android:text="Another text filling in the space here since I still need to
use hold in text to convey size but dont want to use the same one"

        app:layout_constraintTop_toBottomOf="@id/skill_icon"/>



</androidx.constraintlayout.widget.ConstraintLayout>