<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="30dp"
    android:paddingStart="26dp"
    android:orientation="horizontal">


    <ImageView
        android:id="@+id/condition_pane_status_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="4dp"
        android:layout_gravity="center"

        android:background="@drawable/symbol_fire"/>

    <TextView
        android:id="@+id/condition_pane_status_name"
        style="@style/alt_text_bold"
        android:layout_width="150dp"
        android:layout_height="match_parent"

        android:paddingStart="17dp"
        android:layout_marginEnd="8dp"
        android:paddingBottom="2dp"
        android:gravity="bottom"
        android:textColor="#D5000000"
        android:textSize="15sp"

        android:text="DISADVANTAGE_DX"/>


    <TextView
        android:id="@+id/condition_pane_duration_tv"
        style="@style/alt_text_small"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:gravity="bottom"

        android:text="8 turns"
        android:textColor="#D5000000"
        android:textSize="15sp"

        android:paddingBottom="2dp"/>
</LinearLayout>