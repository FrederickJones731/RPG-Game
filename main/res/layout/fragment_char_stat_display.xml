                android:layout_weight="5"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/current_char_level"

                android:text="Lv. 4"
                style="@style/normal_text"


                android:layout_weight="2"
                android:layout_width="0sp"
                android:layout_height="wrap_content"/>

        </TableRow>

