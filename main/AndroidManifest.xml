<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/spinny_hex_thing"
        android:label="@string/app_name"
        android:roundIcon="@drawable/spinny_hex_thing"
        android:screenOrientation="landscape"
        android:theme="@style/Theme.Cordial">
        <activity
            android:name=".prep.onset"
            android:exported="false"
            android:screenOrientation="landscape"/>
        <activity
            android:name=".settei"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".overview.encyclopedia"
            android:exported="false" />
        <activity
            android:name=".prep.prepRoom"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".fight.fightForeground"
            android:launchMode="singleInstance"
            android:screenOrientation="landscape" />
        <activity
            android:name=".prep.warRoom"
            android:exported="false"
            android:launchMode="standard"
            android:screenOrientation="landscape" />
        <activity
            android:name=".fight.gameEndScreen"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>